# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/prisma/generated
.pgdata
.npm-cache
# 3D source scenes (large .blend files, kept locally)
/3D/
/.blender/
/.npm-cache/

# local QA artifacts
/.dev.log
/.build.log
/.start.log
/scripts/3d/previews/
/scripts/shots/

# local working files: model backups and the original photo (web copies live in public/)
/models-backup/
/company.jpg
